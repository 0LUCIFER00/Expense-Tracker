# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Aiven PostgreSQL connection string, from the service's
# "Connection information" panel in the Aiven console.
# DATABASE_URL is also accepted if you prefer the conventional name.
aiven_url = "postgres://USER:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require"

# Signs the session cookie. The server generates one into .env on first run
# if this is missing. Any long random string works:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# API port (default 3000). The Angular dev server proxies /api here.
PORT=3000

# --- WhatsApp (optional) ---
# From Meta for Developers → your app → WhatsApp → API Setup.
# Leave blank to disable the feature; the Settings page then says so.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you invent; paste the same one into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# App Settings → Basic → App Secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Optional: your WhatsApp business number in international form, digits only
# (e.g. 919876543210). Used to build a one-tap "Open WhatsApp" link.
WHATSAPP_BUSINESS_NUMBER=
